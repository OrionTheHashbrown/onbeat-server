{
  "name": "onbeat-fastify-server",
  "version": "2.0.2",
  "description": "OnBeat backend API — Connection to SoundNet & Supabase DB.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@supabase/supabase-js": "^2.115.0",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
